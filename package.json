{
  "name": "mail-mcp",
  "version": "1.0.0",
  "description": "MCP server for any IMAP/SMTP mailbox — read, search, send, reply and organise email from an AI assistant",
  "type": "module",
  "bin": {
    "mail-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "landing.html",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "iconv-lite": "^0.6.3",
    "imapflow": "^1.0.194",
    "nodemailer": "^9.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.2",
    "typescript": "^5.7.0"
  }
}
