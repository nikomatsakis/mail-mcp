# --- Required ----------------------------------------------------------------

# The address you sign in with. For a few providers (iCloud, some corporate
# servers) the login is only the part before @, and MAIL_FROM then carries the
# full address.
MAIL_USER=you@example.com
# Almost every provider refuses the account password over IMAP and issues an
# app-specific password instead. That is the value that belongs here.
MAIL_PASSWORD=your-app-password

# --- Servers ------------------------------------------------------------------

# Naming a provider fills in all four host settings below.
# gmail | outlook | yahoo | icloud | fastmail | zoho | yandex | mailru | gmx |
# aol | migadu | mailbox | proton
# It is also detected from the address, so gmail.com needs nothing here at all.
MAIL_PROVIDER=

# Set these only for a server that has no preset — your own, or a company one.
IMAP_HOST=imap.example.com
IMAP_PORT=993
# Left empty, the port decides: 993 and 465 are TLS, 143 and 587 are STARTTLS.
IMAP_SECURE=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=

# Separate SMTP credentials, if the outgoing server wants its own
SMTP_USER=
SMTP_PASSWORD=

# oauth2 = MAIL_PASSWORD holds an access token rather than a password
MAIL_AUTH_TYPE=

# --- Identity -----------------------------------------------------------------

# Address in the From header. Defaults to MAIL_USER when that is an address.
MAIL_FROM=
# Display name shown next to it
MAIL_FROM_NAME=

# --- Guard rails (optional) ---------------------------------------------------

# true = the server refuses every tool that would send, move, flag or delete
MAIL_READ_ONLY=false
# Comma-separated. When set, mail may only be addressed to these: a full address,
# or a whole domain written as @example.com. Everything else is refused.
MAIL_ALLOWED_RECIPIENTS=
# Comma-separated. When set, only these folders (and their subfolders) are
# reachable; everything else is refused.
MAIL_ALLOWED_FOLDERS=
# Folder used when a tool does not name one
MAIL_DEFAULT_FOLDER=INBOX
# false = do not file a copy of sent mail in the Sent folder
MAIL_APPEND_TO_SENT=true

# --- Hosted mode (optional) ---------------------------------------------------

# http = serve the landing page on / and a stateless MCP endpoint on /mcp
MCP_TRANSPORT=stdio
PORT=8080
HOST=0.0.0.0
# Page served at /; defaults to landing.html next to the compiled output
LANDING_PATH=./landing.html
# When set, only these mail hosts may be targeted by callers
MAIL_ALLOWED_HOSTS=

# --- Everything else (optional) -----------------------------------------------

# false = skip TLS certificate verification (an internal server with its own CA)
MAIL_TLS_REJECT_UNAUTHORIZED=true
# Per-connection timeout in milliseconds
MAIL_TIMEOUT_MS=60000
# Largest attachment the server will read or send, in bytes (8 MB)
MAIL_MAX_ATTACHMENT_BYTES=8388608
# Message bodies longer than this are truncated before reaching the model
MAIL_MAX_BODY_CHARS=40000
# false = refuse to attach files from the local disk (forced off in hosted mode)
MAIL_ALLOW_LOCAL_FILES=true
